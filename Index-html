        let num = counts[s];
        for (let i = 1; i <= num; i++) {
          qList.push({
            id: qId++,
            subject: subj,
            text: `[${subj} - Q${i}] Which of the following represents the correct standard principle or calculation for WAEC / NECO objective question ${i}?`,
            options: [
              `Option A: Standard formula derivation for ${subj} item ${i}`,
              `Option B: Correct verified textbook solution for item ${i}`,
