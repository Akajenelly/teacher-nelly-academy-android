    function generateMathProblem() {
      const ops = ['+', '-', 'x'];
      const op = ops[Math.floor(Math.random() * ops.length)];
      let n1 = Math.floor(Math.random() * 12) + 1;
      let n2 = Math.floor(Math.random() * 12) + 1;
      if (op === '-') { if (n1 < n2) { let temp = n1; n1 = n2; n2 = temp; } }

      if (op === '+') currentMathAns = n1 + n2;
      if (op === '-') currentMathAns = n1 - n2;
      if (op === 'x') currentMathAns = n1 * n2;

      document.getElementById('mathQuestionDisplay').innerText = `${n1} ${op} ${n2} = ?`;

      let options = [currentMathAns];
      while (options.length < 4) {
        let wrong = currentMathAns + (Math.floor(Math.random() * 6) - 3);
        if (wrong !== currentMathAns && !options.includes(wrong) && wrong >= 0) options.push(wrong);
      }
      options.sort(() => Math.random() - 0.5);

      const grid = document.getElementById('mathOptionsGrid');
      grid.innerHTML = '';
      options.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = "py-3 bg-purple-700 hover:bg-purple-600 text-white font-black text-xl rounded-xl shadow transition";
        btn.innerText = opt;
        btn.onclick = () => {
          if (opt === currentMathAns) {
            mathScore += 10;
            document.getElementById('mathGameScore').innerText = mathScore;
            showToast("Correct! +10 pts", "success");
          }
          generateMathProblem();
        };
        grid.appendChild(btn);
      });
    }

