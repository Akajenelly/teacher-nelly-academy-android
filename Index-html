<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Teacher Nelly's Academy - Admin Portal, Phonics & WAEC Prep</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#f0f7ff',
              100: '#e0effe',
              500: '#2563eb',
              600: '#1d4ed8',
              700: '#1e40af',
              900: '#1e3a8a',
            },
            accent: {
              400: '#fbbf24',
              500: '#f59e0b',
            }
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(226, 232, 240, 0.8);
    }
    .gradient-hero {
      background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #4f46e5 100%);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    .ad-banner {
      background: linear-gradient(90deg, #fffbeb 0%, #fef3c7 100%);
      border: 1px dashed #f59e0b;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

  <!-- Top Announcement Bar -->
  <div class="bg-amber-400 text-slate-900 text-xs sm:text-sm font-semibold py-2 px-4 text-center flex flex-wrap items-center justify-center gap-2 shadow-sm">
    <i class="fa-solid fa-graduation-cap text-base"></i>
    <span>Welcome to Teacher Nelly's Academy!</span>
    <a href="#waec-exam" class="underline hover:text-slate-950 font-extrabold ml-1">Take WAEC Practice Exam</a>
  </div>

  <!-- Optional Monetization Top Ad Slot -->
  <div id="topAdSlot" class="hidden max-w-7xl mx-auto w-full px-4 pt-3">
    <div class="ad-banner rounded-xl p-2.5 text-center flex items-center justify-between text-xs text-amber-900">
      <span class="font-bold"><i class="fa-solid fa-rectangle-ad text-amber-600 mr-1.5"></i> ADVERTISEMENT: Boost Your Child's Brain Power with Nelly Reading Kits!</span>
      <button onclick="closeAd('topAdSlot')" class="text-amber-800 hover:text-amber-950 font-bold px-2 py-0.5"><i class="fa-solid fa-xmark"></i></button>
    </div>
  </div>

  <!-- Navigation Header -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3 cursor-pointer" onclick="resetClassFilter()">
        <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-lg shadow-blue-500/30 text-xl font-black">
          N
        </div>
        <div>
          <span class="text-lg font-extrabold text-slate-900 tracking-tight block leading-none">Teacher Nelly's</span>
          <span class="text-xs font-bold text-blue-600 uppercase tracking-widest">Academy</span>
        </div>
      </div>

      <nav class="hidden lg:flex items-center space-x-5 text-xs lg:text-sm font-semibold text-slate-600">
        <a href="#curriculum" class="hover:text-blue-600 transition">Curriculum</a>
        <a href="#phonics" class="hover:text-blue-600 transition font-bold text-emerald-600"><i class="fa-solid fa-font"></i> Phonics A-Z</a>
        <a href="#colors-shapes-diagrams" class="hover:text-blue-600 transition font-bold text-indigo-600"><i class="fa-solid fa-shapes"></i> 2D Colors & Shapes</a>
        <a href="#waec-exam" class="hover:text-blue-600 transition flex items-center gap-1 text-amber-600 font-bold">
          <i class="fa-solid fa-file-signature"></i> WAEC Exam
        </a>
        <a href="#games-arena" class="hover:text-blue-600 transition flex items-center gap-1 text-purple-600 font-bold">
          <i class="fa-solid fa-gamepad"></i> Games Arena
        </a>
        <a href="#parent-hub" class="hover:text-blue-600 transition">Parent Hub</a>
        <a href="#monetization" class="hover:text-blue-600 transition text-indigo-600 font-bold">VIP Upgrade</a>
      </nav>

      <div class="flex items-center space-x-2 sm:space-x-3">
        <!-- Admin Portal Trigger -->
        <button onclick="openAdminModal()" class="inline-flex items-center gap-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs px-3 py-2 rounded-xl font-bold transition shadow-sm">
          <i class="fa-solid fa-user-shield text-amber-400"></i>
          <span>Admin Portal</span>
        </button>

        <!-- Free Registration Button -->
        <button onclick="openParentModal()" id="parentModeBtn" class="inline-flex items-center gap-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs px-3 py-2 rounded-xl font-bold transition border border-blue-200">
          <i class="fa-solid fa-user-plus text-blue-600"></i>
          <span id="parentModeLabel" class="hidden sm:inline">Free Registration</span>
        </button>

        <!-- Unlock Code Button -->
        <button onclick="openUnlockModal()" class="inline-flex items-center gap-1 bg-amber-100 hover:bg-amber-200 text-amber-900 text-xs px-3 py-2 rounded-xl font-bold transition border border-amber-300">
          <i class="fa-solid fa-key text-amber-600"></i>
          <span class="hidden sm:inline">Enter Code</span>
        </button>

        <button onclick="openCheckoutModal('Full Premium VIP Access')" class="inline-flex items-center gap-1.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white text-xs px-3.5 py-2 rounded-xl font-extrabold shadow-md hover:shadow-lg transition">
          <i class="fa-solid fa-crown"></i>
          <span class="hidden xs:inline">VIP Access</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="gradient-hero text-white py-12 lg:py-16 relative overflow-hidden">
    <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-blue-400/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8">
          <span class="inline-flex items-center gap-2 px-3.5 py-1 bg-white/10 backdrop-blur rounded-full text-xs font-bold text-amber-300 uppercase tracking-wider mb-4 border border-white/20">
            <i class="fa-solid fa-star"></i> Excellence in Phonics, Primary & Secondary WAEC Prep
          </span>
          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
            Master Every Subject from <span class="text-amber-300">Pre-Nursery</span> to <span class="text-amber-300">SSS 3</span>
          </h1>
          <p class="text-blue-100 text-sm sm:text-base mb-6 leading-relaxed font-medium max-w-2xl">
            Register your child for free to unlock their class curriculum! Premium courses are securely locked until payment verification or unlock code activation.
          </p>

          <div class="flex flex-wrap gap-3 items-center">
            <button onclick="openParentModal()" class="bg-amber-400 hover:bg-amber-500 text-slate-950 font-extrabold px-5 py-3 rounded-xl shadow-lg transition flex items-center gap-2 text-xs sm:text-sm">
              <i class="fa-solid fa-user-plus"></i>
              <span>Register Child Free</span>
            </button>
            <a href="#phonics" class="bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold px-5 py-3 rounded-xl transition flex items-center gap-2 text-xs sm:text-sm shadow-md">
              <i class="fa-solid fa-font"></i>
              <span>Alphabet A–Z Board</span>
            </a>
            <a href="#colors-shapes-diagrams" class="bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold px-5 py-3 rounded-xl transition flex items-center gap-2 text-xs sm:text-sm shadow-md">
              <i class="fa-solid fa-shapes"></i>
              <span>2D Colors & Shapes</span>
            </a>
            <a href="#waec-exam" class="bg-white/10 hover:bg-white/20 text-white font-extrabold px-5 py-3 rounded-xl border border-white/30 transition flex items-center gap-2 text-xs sm:text-sm">
              <i class="fa-solid fa-pen-clip text-amber-300"></i>
              <span>Take WAEC Exam</span>
            </a>
          </div>
        </div>

        <!-- Quick Status Card -->
        <div class="lg:col-span-4 bg-white/10 backdrop-blur-md rounded-2xl p-5 border border-white/20 text-white shadow-xl">
          <div class="flex items-center justify-between border-b border-white/20 pb-3 mb-3">
            <span class="text-xs font-extrabold text-amber-300 uppercase tracking-wider">Parent Access Status</span>
            <span id="vipStatusBadge" class="bg-amber-400 text-slate-900 text-[10px] font-black px-2 py-0.5 rounded-full uppercase">Free Mode</span>
          </div>
          <div class="space-y-2 text-xs">
            <div class="flex justify-between items-center">
              <span class="text-blue-100">Registered Students:</span>
              <span id="registeredKidsCount" class="font-bold text-white">0 Registered</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-blue-100">Class Visibility:</span>
              <span id="classVisibilityText" class="font-bold text-emerald-300">Unlocked & Active</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-blue-100">Premium VIP Access:</span>
              <span id="premiumStatusText" class="font-bold text-amber-300">Standard Account</span>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-white/20 flex gap-2">
            <button onclick="openParentModal()" class="flex-1 bg-white text-slate-900 font-extrabold py-2 rounded-lg text-xs hover:bg-slate-100 transition text-center">
              Register Student
            </button>
            <button onclick="openAdminModal()" class="flex-1 bg-slate-900 text-amber-400 font-extrabold py-2 rounded-lg text-xs hover:bg-slate-800 transition text-center border border-amber-400/40">
              Admin Login
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Container with Organized Sections -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow w-full space-y-20">

    <!-- SECTION 1: PHONICS A-Z BOARD -->
    <section id="phonics" class="bg-gradient-to-br from-blue-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden border border-indigo-800">
      <div class="relative z-10">
        <div class="flex items-center justify-between flex-wrap gap-4 mb-6">
          <div>
            <div class="flex items-center gap-3 mb-1">
              <span class="bg-amber-400 text-slate-950 font-black px-3 py-1 rounded-full text-xs uppercase shadow-sm">
                🔤 Restored Phonics Board
              </span>
              <span class="text-emerald-400 text-xs font-bold"><i class="fa-solid fa-volume-high"></i> Voice & Words Active</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white">A–Z Alphabet & Meaning Board</h2>
            <p class="text-slate-300 text-xs sm:text-sm mt-1">
              Click any letter below to hear Teacher Nelly speak, see the full word it stands for, and view its picture & sample sentence!
            </p>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="playFullAlphabetSong()" class="bg-amber-400 hover:bg-amber-500 text-slate-950 text-xs font-black px-4 py-2.5 rounded-xl shadow transition flex items-center gap-2">
              <i class="fa-solid fa-music"></i> Play A–Z Audio Tour
            </button>
          </div>
        </div>

        <!-- Active Letter Preview Spotlight Box -->
        <div id="alphabetSpotlight" class="bg-white/10 backdrop-blur border border-white/20 rounded-2xl p-5 mb-6 flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left">
          <div id="spotlightEmoji" class="w-24 h-24 rounded-2xl bg-gradient-to-tr from-amber-400 to-amber-200 text-slate-950 text-6xl flex items-center justify-center font-black shadow-lg shrink-0">
            🍎
          </div>
          <div class="space-y-1 flex-grow">
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3">
              <span id="spotlightLetter" class="text-4xl font-black text-amber-300">Aa</span>
              <span id="spotlightWord" class="text-2xl font-extrabold text-white">Stands for: APPLE</span>
              <button onclick="speakAlphabetItem()" class="bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold px-3 py-1 rounded-lg flex items-center gap-1">
                <i class="fa-solid fa-volume-high"></i> Listen Pronunciation
              </button>
            </div>
            <p id="spotlightPhonicsSound" class="text-emerald-300 text-xs font-semibold">Phonics Sound: "/æ/ as in Apple"</p>
            <p id="spotlightSentence" class="text-slate-200 text-xs sm:text-sm italic">"An apple a day keeps the doctor away!"</p>
          </div>
        </div>

        <!-- 26 Letter Grid -->
        <div id="phonicsGrid" class="grid grid-cols-2 xs:grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-9 gap-3">
          <!-- Populated dynamically via JS -->
        </div>
      </div>
    </section>

    <!-- SECTION 2: 2D VISUAL COLORS & SHAPES DIAGRAMS -->
    <section id="colors-shapes-diagrams" class="bg-gradient-to-br from-indigo-950 via-slate-900 to-blue-950 text-white rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden border border-indigo-900">
      <div class="relative z-10 space-y-6">
        <div class="flex items-center justify-between flex-wrap gap-4">
          <div>
            <div class="flex items-center gap-3 mb-1">
              <span class="bg-indigo-500 text-white font-black px-3 py-1 rounded-full text-xs uppercase shadow-sm">
                🎨 Visual Learning Diagrams
              </span>
              <span class="text-amber-400 text-xs font-bold"><i class="fa-solid fa-palette"></i> Pre-School & Basic Explorer</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white">2D Visual Colors & Geometry Shapes Diagrams</h2>
            <p class="text-slate-300 text-xs sm:text-sm mt-1">
              Interactive visual diagrams for nursery and primary students. Click any color swatch or 2D geometric shape to inspect properties and hear audio descriptions!
            </p>
          </div>
          <button onclick="speakAllDiagrams()" class="bg-amber-400 hover:bg-amber-500 text-slate-950 text-xs font-black px-4 py-2.5 rounded-xl shadow transition flex items-center gap-2">
            <i class="fa-solid fa-volume-high"></i> Read Color & Shape Guide
          </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- PART A: 2D COLORS PALETTE DIAGRAM -->
          <div class="lg:col-span-6 bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20 space-y-4">
            <div class="flex items-center justify-between border-b border-white/20 pb-3">
              <h3 class="text-lg font-extrabold text-amber-300 flex items-center gap-2">
                <i class="fa-solid fa-droplet"></i> Primary & Secondary Colors Diagram
              </h3>
              <span class="text-xs text-slate-300 font-bold">Tap to Inspect</span>
            </div>
            
            <div id="colorsDiagramGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <!-- Rendered via JS -->
            </div>

            <div id="activeColorSpotlight" class="bg-slate-900/80 border border-white/20 rounded-xl p-4 text-xs space-y-1">
              <span class="text-amber-400 font-bold uppercase tracking-wider block">Selected Color Property:</span>
              <p id="colorSpotlightDesc" class="text-slate-200">Click any color tile above to view its educational details and real-world examples.</p>
            </div>
          </div>

          <!-- PART B: 2D GEOMETRIC SHAPES DIAGRAM -->
          <div class="lg:col-span-6 bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20 space-y-4">
            <div class="flex items-center justify-between border-b border-white/20 pb-3">
              <h3 class="text-lg font-extrabold text-indigo-300 flex items-center gap-2">
                <i class="fa-solid fa-shapes"></i> 2D Geometric Shapes Diagram
              </h3>
              <span class="text-xs text-slate-300 font-bold">Tap to Inspect</span>
            </div>

            <div id="shapesDiagramGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <!-- Rendered via JS -->
            </div>

            <div id="activeShapeSpotlight" class="bg-slate-900/80 border border-white/20 rounded-xl p-4 text-xs space-y-1">
              <span class="text-indigo-400 font-bold uppercase tracking-wider block">Selected 2D Shape Property:</span>
              <p id="shapeSpotlightDesc" class="text-slate-200">Click any 2D shape tile above to examine its sides, angles, and formula properties.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION 3: ACADEMIC CURRICULUM -->
    <section id="curriculum">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Academic Curriculum & Topics</h2>
            <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-1 rounded-full"><i class="fa-solid fa-check-circle"></i> Open & VIP Access</span>
          </div>
          <p class="text-slate-500 text-xs sm:text-sm mt-1">Structured learning modules across English, Science, Grammar, Sentences, Prepositions & Concord. Premium lessons require payment verification or VIP code.</p>
        </div>

        <!-- Search Input -->
        <div class="relative w-full md:w-80">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input type="text" id="searchInput" oninput="handleSearch()" placeholder="Search topic (e.g., Concord, Prepositions)..." class="w-full pl-10 pr-4 py-2 bg-white border border-slate-300 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm">
        </div>
      </div>

      <!-- Class Level Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-6 custom-scrollbar" id="levelTabs">
        <!-- Dynamic Tabs Rendered via JS -->
      </div>

      <!-- Subject Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 mb-6" id="subjectFilterPills">
        <span class="text-xs font-bold text-slate-500 mr-2"><i class="fa-solid fa-filter"></i> Filter Subject:</span>
        <button onclick="filterSubject('All')" id="subBtn-All" class="px-3 py-1 rounded-lg text-xs font-bold bg-slate-900 text-white shadow-sm">All Subjects</button>
        <button onclick="filterSubject('English')" id="subBtn-English" class="px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200">English & Grammar</button>
        <button onclick="filterSubject('Mathematics')" id="subBtn-Mathematics" class="px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200">Mathematics</button>
        <button onclick="filterSubject('Sciences')" id="subBtn-Sciences" class="px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200">Sciences</button>
        <button onclick="filterSubject('WAEC Prep')" id="subBtn-WAEC Prep" class="px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200">WAEC & NECO</button>
        <button onclick="filterSubject('ICT & Tech')" id="subBtn-ICT & Tech" class="px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200">ICT & Computing</button>
      </div>

      <!-- Curriculum Cards Grid -->
      <div id="curriculumContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Dynamic Cards Rendered via JS -->
      </div>
    </section>

    <!-- SECTION 4: WAEC & NECO EXAMINATION PORTAL -->
    <section id="waec-exam" class="bg-slate-900 text-white rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-2xl relative overflow-hidden">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 border-b border-slate-800 pb-6">
        <div>
          <span class="px-3 py-1 bg-amber-400 text-slate-950 font-black rounded-full text-xs uppercase shadow-sm">
            🏆 Full WAEC & NECO Examination Portal
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-2">100-Question Comprehensive Practice Exam</h2>
          <p class="text-slate-400 text-xs sm:text-sm mt-1">
            Mathematics (20) • English Language (20) • Chemistry (15) • Physics (15) • Biology (15) • General Studies (15)
          </p>
        </div>

        <!-- Exam Controls Header -->
        <div id="examHeaderStats" class="flex flex-wrap items-center gap-3">
          <div class="bg-slate-800 border border-slate-700 px-4 py-2 rounded-xl text-center">
            <span class="text-[10px] text-slate-400 font-bold block uppercase">Timer</span>
            <span id="examTimerDisplay" class="text-lg font-black text-amber-400 font-mono">120:00</span>
          </div>
          <div class="bg-slate-800 border border-slate-700 px-4 py-2 rounded-xl text-center">
            <span class="text-[10px] text-slate-400 font-bold block uppercase">Answered</span>
            <span id="examProgressCount" class="text-lg font-black text-emerald-400 font-mono">0 / 100</span>
          </div>
        </div>
      </div>

      <!-- Start Exam Screen -->
      <div id="examStartScreen" class="py-8 text-center max-w-2xl mx-auto space-y-6">
        <div class="w-16 h-16 rounded-2xl bg-amber-400 text-slate-950 flex items-center justify-center font-black text-3xl mx-auto shadow-xl">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white">Ready to test your WAEC/NECO Readiness?</h3>
        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
          Take the official 100-question practice test with instant explanations for every question, subject-by-subject score breakdown, and performance rationale.
        </p>

        <button onclick="startWAECExam()" class="bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-950 font-extrabold text-sm sm:text-base px-8 py-3.5 rounded-2xl shadow-xl transition transform active:scale-95 flex items-center gap-2 mx-auto">
          <i class="fa-solid fa-play"></i> Start 100-Question Exam Now
        </button>
      </div>

      <!-- Exam Active UI -->
      <div id="examActiveUI" class="hidden space-y-6">
        <div class="space-y-3">
