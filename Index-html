        const btn = document.createElement('button');
        btn.className = "bg-white/10 hover:bg-white/20 border border-white/20 p-4 rounded-2xl flex flex-col items-center justify-center gap-2 transition transform hover:scale-105 shadow";
        btn.innerHTML = `<span class="text-4xl">${item.emoji}</span><span class="text-xs font-bold text-amber-300 font-mono">${item.word}</span>`;
        btn.onclick = () => {
          if (item.letter === currentPhonicsTarget.letter) {
            phonicsGameScore += 15;
            document.getElementById('phonicsGameScore').innerText = phonicsGameScore;
            document.getElementById('phonicsGameFeedback').innerText = "Correct! Great job matching!";
            speakText("Correct! Well done.");
            setTimeout(() => {
              document.getElementById('phonicsGameFeedback').innerText = "";
              nextPhonicsRound();
            }, 1200);
          } else {
            document.getElementById('phonicsGameFeedback').innerText = "Incorrect! Try again.";
            speakText("Incorrect. Try another card.");
          }
        };
        grid.appendChild(btn);
      });
    }

    function speakPhonicsGamePrompt() {
      if (currentPhonicsTarget) {
        speakText(`Find ${currentPhonicsTarget.word}. ${currentPhonicsTarget.phonics}`);
      }
    }

    // Science Memory Match Game Logic (Fully Fixed Matching Grid)
    const scienceMemoryPairs = [
      { id: 1, name: "Atom", icon: "⚛️" },
      { id: 2, name: "DNA", icon: "🧬" },
      { id: 3, name: "Plant", icon: "🌱" },
      { id: 4, name: "Magnet", icon: "🧲" },
      { id: 5, name: "Microscope", icon: "🔬" },
      { id: 6, name: "Planet", icon: "🪐" }
    ];

    let memoryCards = [];
    let firstCard = null;
    let secondCard = null;
    let lockBoard = false;
    let memoryFlips = 0;
    let memoryMatchedPairs = 0;

    function initScienceMemoryGame() {
      memoryFlips = 0;
      memoryMatchedPairs = 0;
      firstCard = null;
      secondCard = null;
      lockBoard = false;

      document.getElementById('memoryFlipsCount').innerText = memoryFlips;
      document.getElementById('memoryPairsCount').innerText = `${memoryMatchedPairs} / 6`;

      // Duplicate for pairs
      let deck = [...scienceMemoryPairs, ...scienceMemoryPairs]
        .sort(() => Math.random() - 0.5)
        .map((item, index) => ({
          uniqueId: index,
          name: item.name,
          icon: item.icon,
          isFlipped: false,
          isMatched: false
        }));

      memoryCards = deck;
      renderMemoryGrid();
    }

    function renderMemoryGrid() {
      const grid = document.getElementById('memoryGrid');
      if (!grid) return;
      grid.innerHTML = '';

      memoryCards.forEach((card, idx) => {
        const btn = document.createElement('button');
        btn.className = `h-20 rounded-2xl border text-2xl font-bold transition flex items-center justify-center shadow ${card.isFlipped || card.isMatched ? 'bg-emerald-700 text-white border-emerald-500 font-black' : 'bg-white/10 hover:bg-white/20 text-emerald-400 border-white/20'}`;
        btn.innerHTML = card.isFlipped || card.isMatched ? `<span>${card.icon}</span>` : `<span class="text-xs text-emerald-300 font-mono">#${idx + 1}</span>`;
        btn.onclick = () => flipMemoryCard(idx);
        grid.appendChild(btn);
      });
    }

    function flipMemoryCard(idx) {
      if (lockBoard) return;
      let clicked = memoryCards[idx];
      if (clicked.isFlipped || clicked.isMatched) return;

      clicked.isFlipped = true;
      memoryFlips++;
      document.getElementById('memoryFlipsCount').innerText = memoryFlips;
      renderMemoryGrid();

      if (!firstCard) {
        firstCard = { index: idx, card: clicked };
      } else {
        secondCard = { index: idx, card: clicked };
        checkForMemoryMatch();
      }
    }

    function checkForMemoryMatch() {
      let isMatch = firstCard.card.name === secondCard.card.name;

      if (isMatch) {
        memoryCards[firstCard.index].isMatched = true;
        memoryCards[secondCard.index].isMatched = true;
        memoryMatchedPairs++;
        document.getElementById('memoryPairsCount').innerText = `${memoryMatchedPairs} / 6`;
        resetMemoryTurn();

        if (memoryMatchedPairs === 6) {
          showToast(`Fantastic! Science Memory completed in ${memoryFlips} flips!`, "success");
          speakText("Fantastic! You matched all science memory pairs successfully!");
        }
      } else {
        lockBoard = true;
        setTimeout(() => {
          memoryCards[firstCard.index].isFlipped = false;
          memoryCards[secondCard.index].isFlipped = false;
          resetMemoryTurn();
          renderMemoryGrid();
        }, 1000);
      }
    }

    function resetMemoryTurn() {
      firstCard = null;
      secondCard = null;
      lockBoard = false;
    }

    // --- PARENT HUB & REGISTRATION ---
    function openParentModal() {
      document.getElementById('parentModal').classList.remove('hidden');
    }
    function closeParentModal() {
      document.getElementById('parentModal').classList.add('hidden');
    }

    function handleRegisterChild(event) {
      event.preventDefault();
      const name = document.getElementById('childNameInput').value.trim();
      const phone = document.getElementById('childParentPhoneInput').value.trim();
      const classLevel = document.getElementById('childClassInput').value;

      const newStudent = {
        id: state.registeredStudents.length + 1,
        name: name,
        classLevel: classLevel,
        parentPhone: phone,
        date: new Date().toISOString().split('T')[0],
        isVIP: state.isVIP
      };

      state.registeredStudents.unshift(newStudent);
      closeParentModal();
      updateDashboardStats();
      renderRegisteredSiblings();
      showToast(`Student ${name} successfully registered for free!`, "success");
      document.getElementById('childNameInput').value = '';
      document.getElementById('childParentPhoneInput').value = '';
    }

    function renderRegisteredSiblings() {
      const container = document.getElementById('registeredSiblingsList');
      if (!container) return;
      container.innerHTML = '';
      if (state.registeredStudents.length === 0) {
        container.innerHTML = `<p class="text-xs text-slate-400">No students registered yet.</p>`;
        return;
      }
      state.registeredStudents.slice(0, 3).forEach(s => {
        const div = document.createElement('div');
        div.className = "flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-xs";
        div.innerHTML = `<div><span class="font-bold text-slate-900 block">${s.name}</span><span class="text-[10px] text-slate-500">${s.classLevel} • Tel: ${s.parentPhone}</span></div><span class="px-2 py-0.5 rounded-full text-[10px] font-black ${s.isVIP ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800'}">${s.isVIP ? 'VIP' : 'Free'}</span>`;
        container.appendChild(div);
      });
    }

    function handleParentInquiry(event) {
      event.preventDefault();
      const name = document.getElementById('parentName').value.trim();
      const phone = document.getElementById('parentPhone').value.trim();
      const classLevel = document.getElementById('parentClassSelect').value;
      const category = document.getElementById('inquiryCategory').value;
      const message = document.getElementById('parentMessage').value.trim();

      state.parentInquiries.unshift({
        id: state.parentInquiries.length + 1,
        parentName: name,
        parentPhone: phone,
        classLevel: classLevel,
        category: category,
        message: message,
        date: new Date().toISOString().split('T')[0]
      });

      showToast("Parent inquiry submitted successfully to Teacher Nelly!", "success");
      event.target.reset();
      updateDashboardStats();
    }

    // --- CHECKOUT & UNLOCK CODES ---
    function openCheckoutModal(planTitle = 'Termly Plan (₦15,000)') {
      state.selectedPlan = planTitle;
      document.getElementById('checkoutPlanTitle').innerText = planTitle;
      document.getElementById('checkoutModal').classList.remove('hidden');
    }
    function closeCheckoutModal() {
      document.getElementById('checkoutModal').classList.add('hidden');
    }

    function submitPaymentForVerification() {
      const name = document.getElementById('depositorName').value.trim();
      const refId = document.getElementById('paymentReferenceId').value.trim();
      const phone = document.getElementById('depositorPhone').value.trim();

      if (!name || !refId || !phone) {
        showToast("Please fill in all payment verification details.", "info");
        return;
      }

      state.paymentVerifications.unshift({
        id: state.paymentVerifications.length + 1,
        depositorName: name,
        referenceId: refId,
        phone: phone,
        plan: state.selectedPlan,
        status: "Pending Verification",
        date: new Date().toISOString().split('T')[0]
      });

      closeCheckoutModal();
      showToast("Payment submitted for First Bank verification! Teacher Nelly will issue your code shortly.", "success");
      updateDashboardStats();
    }

    function openUnlockModal() {
      document.getElementById('unlockModal').classList.remove('hidden');
    }
    function closeUnlockModal() {
      document.getElementById('unlockModal').classList.add('hidden');
    }

    function verifyUnlockCode() {
      const code = document.getElementById('unlockCodeInput').value.trim().toUpperCase();
      if (state.activeCodes.includes(code)) {
        state.isVIP = true;
        closeUnlockModal();
        updateDashboardStats();
        renderCurriculumCards();
        showToast(`VIP Unlock Code "${code}" verified successfully! All lessons unlocked.`, "success");
      } else {
        showToast("Invalid VIP unlock code. Please check or complete First Bank payment.", "info");
      }
    }

    // --- ADMIN PORTAL LOGIC ---
    function openAdminModal() {
      document.getElementById('adminModal').classList.remove('hidden');
      if (state.isAdminLoggedIn) {
        document.getElementById('adminLoginForm').classList.add('hidden');
        document.getElementById('adminDashboardContent').classList.remove('hidden');
        renderAdminDashboard();
      } else {
        document.getElementById('adminLoginForm').classList.remove('hidden');
        document.getElementById('adminDashboardContent').classList.add('hidden');
      }
    }
    function closeAdminModal() {
      document.getElementById('adminModal').classList.add('hidden');
    }

    function handleAdminLogin(event) {
      event.preventDefault();
      const pass = document.getElementById('adminPasscodeInput').value;
      if (pass === state.adminPassword) {
        state.isAdminLoggedIn = true;
        document.getElementById('adminLoginForm').classList.add('hidden');
        document.getElementById('adminDashboardContent').classList.remove('hidden');
        renderAdminDashboard();
        showToast("Admin signed in successfully!", "success");
      } else {
        showToast("Incorrect admin passcode. Try ADMIN123", "info");
      }
    }

    function handleAdminLogout() {
      state.isAdminLoggedIn = false;
      document.getElementById('adminPasscodeInput').value = '';
      document.getElementById('adminDashboardContent').classList.add('hidden');
      document.getElementById('adminLoginForm').classList.remove('hidden');
      showToast("Signed out of admin portal.", "success");
    }

    // CHANGE PASSWORD FEATURE
    function openChangePasswordModal() {
      document.getElementById('changePasswordModal').classList.remove('hidden');
    }
    function closeChangePasswordModal() {
      document.getElementById('changePasswordModal').classList.add('hidden');
    }

    function handlePasswordChange(event) {
      event.preventDefault();
      const currentPass = document.getElementById('currentPasswordInput').value;
      const newPass = document.getElementById('newPasswordInput').value;
      const confirmPass = document.getElementById('confirmPasswordInput').value;

      if (currentPass !== state.adminPassword) {
        showToast("Current password is incorrect.", "info");
        return;
      }
      if (newPass !== confirmPass) {
        showToast("New passwords do not match.", "info");
        return;
      }
      if (newPass.length < 4) {
        showToast("Password must be at least 4 characters long.", "info");
        return;
      }

      state.adminPassword = newPass;
      closeChangePasswordModal();
      showToast("Admin password successfully updated!", "success");
      event.target.reset();
    }

    function updateDashboardStats() {
      document.getElementById('registeredKidsCount').innerText = `${state.registeredStudents.length} Registered`;
      document.getElementById('vipStatusBadge').innerText = state.isVIP ? "VIP Active Pass" : "Free Mode";
      document.getElementById('vipStatusBadge').className = state.isVIP ? "bg-amber-400 text-slate-950 text-[10px] font-black px-2 py-0.5 rounded-full uppercase shadow" : "bg-slate-700 text-amber-300 text-[10px] font-black px-2 py-0.5 rounded-full uppercase";
      document.getElementById('premiumStatusText').innerText = state.isVIP ? "Full VIP Unlocked" : "Standard Account";

      const adminStudents = document.getElementById('adminMetricStudents');
      if (adminStudents) adminStudents.innerText = state.registeredStudents.length;
      const adminInquiries = document.getElementById('adminMetricInquiries');
      if (adminInquiries) adminInquiries.innerText = state.parentInquiries.length;
      const adminPayments = document.getElementById('adminMetricPayments');
      if (adminPayments) adminPayments.innerText = state.paymentVerifications.length;

      const incCount = document.getElementById('inquiryTabCount');
      if (incCount) incCount.innerText = state.parentInquiries.length;
      const payCount = document.getElementById('paymentTabCount');
      if (payCount) payCount.innerText = state.paymentVerifications.length;
    }

    function renderAdminDashboard() {
      updateDashboardStats();
      renderAdminUserTable();
      renderAdminInquiries();
      renderAdminPayments();
      renderAdminCodes();
    }

    function switchAdminTab(tab) {
      document.getElementById('adminTabContentUsers').classList.add('hidden');
      document.getElementById('adminTabContentInquiries').classList.add('hidden');
      document.getElementById('adminTabContentPayments').classList.add('hidden');
      document.getElementById('adminTabContentCodes').classList.add('hidden');

      document.getElementById('adminTabUsers').className = "px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 whitespace-nowrap";
      document.getElementById('adminTabInquiries').className = "px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 whitespace-nowrap";
      document.getElementById('adminTabPayments').className = "px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 whitespace-nowrap";
      document.getElementById('adminTabCodes').className = "px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 whitespace-nowrap";

      if (tab === 'users') {
        document.getElementById('adminTabContentUsers').classList.remove('hidden');
        document.getElementById('adminTabUsers').className = "px-4 py-2 rounded-xl text-xs font-extrabold bg-slate-900 text-white whitespace-nowrap";
        renderAdminUserTable();
      } else if (tab === 'inquiries') {
        document.getElementById('adminTabContentInquiries').classList.remove('hidden');
        document.getElementById('adminTabInquiries').className = "px-4 py-2 rounded-xl text-xs font-extrabold bg-slate-900 text-white whitespace-nowrap";
        renderAdminInquiries();
      } else if (tab === 'payments') {
        document.getElementById('adminTabContentPayments').classList.remove('hidden');
        document.getElementById('adminTabPayments').className = "px-4 py-2 rounded-xl text-xs font-extrabold bg-slate-900 text-white whitespace-nowrap";
        renderAdminPayments();
      } else if (tab === 'codes') {
        document.getElementById('adminTabContentCodes').classList.remove('hidden');
        document.getElementById('adminTabCodes').className = "px-4 py-2 rounded-xl text-xs font-extrabold bg-slate-900 text-white whitespace-nowrap";
        renderAdminCodes();
      }
    }

    function renderAdminUserTable() {
      const tbody = document.getElementById('adminUserTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';
      const search = (document.getElementById('adminUserSearch').value || '').toLowerCase();

      const filtered = state.registeredStudents.filter(s => s.name.toLowerCase().includes(search) || s.parentPhone.includes(search) || s.classLevel.toLowerCase().includes(search));

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="p-4 text-center text-slate-400">No registered students found.</td></tr>`;
        return;
      }

      filtered.forEach((s, idx) => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 transition";
        tr.innerHTML = `
          <td class="p-3 font-mono">${idx + 1}</td>
          <td class="p-3 font-bold text-slate-900">${s.name}</td>
          <td class="p-3">${s.classLevel}</td>
          <td class="p-3 font-mono">${s.parentPhone}</td>
          <td class="p-3 text-slate-500">${s.date}</td>
          <td class="p-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-black ${s.isVIP ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-600'}">${s.isVIP ? 'VIP' : 'Free'}</span></td>
          <td class="p-3 text-right">
            <button onclick="toggleStudentVIP(${s.id})" class="text-xs font-bold text-blue-600 hover:underline mr-2">${s.isVIP ? 'Revoke VIP' : 'Make VIP'}</button>
            <button onclick="deleteStudent(${s.id})" class="text-xs font-bold text-red-600 hover:underline">Delete</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function toggleStudentVIP(id) {
      const st = state.registeredStudents.find(s => s.id === id);
      if (st) {
        st.isVIP = !st.isVIP;
        renderAdminUserTable();
        showToast(`Updated VIP status for ${st.name}`, "success");
      }
    }

    function deleteStudent(id) {
      state.registeredStudents = state.registeredStudents.filter(s => s.id !== id);
      renderAdminUserTable();
      updateDashboardStats();
      showToast("Student deleted from records.", "success");
    }

    function renderAdminInquiries() {
      const list = document.getElementById('adminInquiriesList');
      if (!list) return;
      list.innerHTML = '';
      if (state.parentInquiries.length === 0) {
        list.innerHTML = `<p class="text-xs text-slate-400">No parent inquiries submitted yet.</p>`;
        return;
      }
      state.parentInquiries.forEach(inq => {
        const div = document.createElement('div');
        div.className = "p-4 bg-slate-50 border border-slate-200 rounded-2xl space-y-2 text-xs";
        div.innerHTML = `
          <div class="flex items-center justify-between"><span class="font-bold text-slate-900">${inq.parentName} (${inq.parentPhone})</span><span class="text-slate-500">${inq.date}</span></div>
          <div class="text-[11px] font-bold text-amber-700">Class: ${inq.classLevel} • Category: ${inq.category}</div>
          <p class="text-slate-700 bg-white p-2.5 rounded-xl border border-slate-200">${inq.message}</p>
        `;
        list.appendChild(div);
      });
    }

    function renderAdminPayments() {
      const list = document.getElementById('adminPaymentsList');
      if (!list) return;
      list.innerHTML = '';
      if (state.paymentVerifications.length === 0) {
        list.innerHTML = `<p class="text-xs text-slate-400">No payment verifications submitted yet.</p>`;
        return;
      }
      state.paymentVerifications.forEach(pay => {
        const div = document.createElement('div');
        div.className = "p-4 bg-slate-50 border border-slate-200 rounded-2xl space-y-2 text-xs";
        div.innerHTML = `
          <div class="flex items-center justify-between"><span class="font-bold text-slate-900">${pay.depositorName} (${pay.phone})</span><span class="font-mono text-emerald-600 font-bold">Ref: ${pay.referenceId}</span></div>
          <div class="text-[11px] font-bold text-blue-700">Plan: ${pay.plan} • Date: ${pay.date}</div>
          <div class="flex items-center justify-between pt-2">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-900">${pay.status}</span>
            <button onclick="approvePayment(${pay.id})" class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold px-3 py-1.5 rounded-xl transition">
              Verify & Issue VIP Code
            </button>
          </div>
        `;
        list.appendChild(div);
      });
    }

    function approvePayment(id) {
      const pay = state.paymentVerifications.find(p => p.id === id);
      if (pay) {
        pay.status = "Verified & Approved";
        renderAdminPayments();
        showToast(`Payment ${pay.referenceId} approved! Student verified.`, "success");
      }
    }

    function renderAdminCodes() {
      const list = document.getElementById('adminActiveCodesList');
      if (!list) return;
      list.innerHTML = '';
      state.activeCodes.forEach(code => {
        const li = document.createElement('li');
        li.className = "flex items-center justify-between bg-slate-50 p-2.5 rounded-xl border border-slate-200 text-xs";
        li.innerHTML = `<span class="font-bold text-slate-900 font-mono">${code}</span><span class="text-emerald-600 font-bold"><i class="fa-solid fa-check-circle mr-1"></i> Active</span>`;
        list.appendChild(li);
      });
    }

    function generateCustomAdminCode() {
      const input = document.getElementById('newCodeInput');
      const val = input.value.trim().toUpperCase();
      if (!val) {
        showToast("Please enter a valid unlock code name.", "info");
        return;
      }
      if (!state.activeCodes.includes(val)) {
        state.activeCodes.push(val);
        input.value = '';
        renderAdminCodes();
        showToast(`New custom VIP code "${val}" generated successfully!`, "success");
      } else {
        showToast("Code already exists.", "info");
      }
    }

    function exportUserDataCSV() {
      let csv = "ID,Student Name,Class Level,Parent Phone,Registration Date,VIP Status\n";
      state.registeredStudents.forEach(s => {
        csv += `${s.id},"${s.name}","${s.classLevel}","${s.parentPhone}","${s.date}",${s.isVIP ? 'VIP' : 'Free'}\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.setAttribute('href', url);
      a.setAttribute('download', 'TeacherNelly_Registered_Students.csv');
      a.click();
      showToast("CSV export completed successfully!", "success");
    }

    function closeAd(id) {
      document.getElementById(id).classList.add('hidden');
    }
    function resetClassFilter() {
      state.selectedLevel = 'All';
      state.selectedSubject = 'All';
      renderLevelTabs();
      renderCurriculumCards();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  </script>
